APP_NAME=设备检修智能辅助系统
APP_ENV=development
DEBUG=false
API_PREFIX=/api
FRONTEND_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
DATA_DIR=../data

# DeepSeek LLM API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=3072

# 硅基流动 Embedding API
# 在 https://siliconflow.cn 注册获取，不填则自动回退到本地 ManualHashEmbedding
# 首选 Qwen3-Embedding-8B(4096d)，余额不足时自动降级到 BGE-large-zh-v1.5(1024d)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# 硅基流动 Reranker API（精排检索结果）
# 首选 Qwen3-VL-Reranker-8B，余额不足时自动降级到 BGE-reranker-v2-m3
RERANKER_ENABLED=true
RERANKER_MODEL=Qwen/Qwen3-VL-Reranker-8B
RERANKER_FALLBACK_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5
RERANKER_RETRIEVE_MULTIPLIER=4

# HyDE 查询改写（用 LLM 生成假想手册片段辅助检索，有额外 LLM 调用成本）
HYDE_ENABLED=false

# Harness feature flags（设为 false 可回退到旧 13 节点 DAG）
USE_ORCHESTRATOR=true
USE_INPUT_GUARDRAIL=true
USE_REAL_AI_CODING=true
USE_EVALUATOR_OPTIMIZER=true
EVALUATOR_MAX_ITERATIONS=3
EVALUATOR_CONFIDENCE_THRESHOLD=0.7
USE_OUTPUT_GUARDRAIL=true
TRACE_STORAGE_PATH=../data/traces
TRACE_EXPORTERS=console,json
MEMORY_MAX_WINDOW=20
MEMORY_SUMMARY_TRIGGER=15
STREAMING_ENABLED=true
