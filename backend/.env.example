APP_NAME=设备检修智能辅助系统
APP_ENV=development
DEBUG=false
API_PREFIX=/api
FRONTEND_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
DATA_DIR=../data

# DeepSeek LLM API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=3072

# 硅基流动 Embedding API（BGE-large-zh-v1.5）
# 在 https://siliconflow.cn 注册获取，不填则自动回退到本地 ManualHashEmbedding
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Harness feature flags（设为 false 可回退到旧 13 节点 DAG）
USE_ORCHESTRATOR=true
USE_INPUT_GUARDRAIL=true
USE_REAL_AI_CODING=true
USE_EVALUATOR_OPTIMIZER=true
EVALUATOR_MAX_ITERATIONS=3
EVALUATOR_CONFIDENCE_THRESHOLD=0.7
USE_OUTPUT_GUARDRAIL=true
TRACE_STORAGE_PATH=../data/traces
TRACE_EXPORTERS=console,json
MEMORY_MAX_WINDOW=20
MEMORY_SUMMARY_TRIGGER=15
STREAMING_ENABLED=true
